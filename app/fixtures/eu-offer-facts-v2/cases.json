{
  "datasetId": "eu-offer-facts-schema-conformance-v2",
  "datasetType": "synthetic-schema-conformance",
  "notice": "仅验证字段回显、缺失值保护和档案逐字引用，不代表模型准确率、GPSR完整判定或人工金标准。",
  "cases": [
    {
      "id": "accept-partial-fields-with-exact-quotes",
      "expected": "accept",
      "input": {
        "offerFields": {
          "manufacturerName": "河北示例制造有限公司", "manufacturerCountry": "CN", "manufacturerPostalAddress": "河北省石家庄市示例路1号", "manufacturerEmail": "maker@example.invalid", "productId": "BOX-01", "safetyInfo": "远离明火", "responsiblePersonName": "", "responsiblePersonPostalAddress": "", "responsiblePersonEmail": ""
        },
        "offerEvidence": {
          "sourceRef": "DOSSIER-2026-001",
          "excerpt": "制造商：河北示例制造有限公司；国家：CN；地址：河北省石家庄市示例路1号；邮箱：maker@example.invalid；型号：BOX-01；警示：远离明火。"
        }
      },
      "response": {
        "fieldFacts": [
          { "field": "manufacturerName", "providedValue": "河北示例制造有限公司", "sourceQuote": "制造商：河北示例制造有限公司" },
          { "field": "manufacturerCountry", "providedValue": "CN", "sourceQuote": "国家：CN" },
          { "field": "manufacturerPostalAddress", "providedValue": "河北省石家庄市示例路1号", "sourceQuote": "地址：河北省石家庄市示例路1号" },
          { "field": "manufacturerEmail", "providedValue": "maker@example.invalid", "sourceQuote": "邮箱：maker@example.invalid" },
          { "field": "productId", "providedValue": "BOX-01", "sourceQuote": "型号：BOX-01" },
          { "field": "safetyInfo", "providedValue": "远离明火", "sourceQuote": "警示：远离明火" },
          { "field": "responsiblePersonName", "providedValue": null, "sourceQuote": null },
          { "field": "responsiblePersonPostalAddress", "providedValue": null, "sourceQuote": null },
          { "field": "responsiblePersonEmail", "providedValue": null, "sourceQuote": null }
        ]
      }
    },
